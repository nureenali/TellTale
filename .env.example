# GEMINI_API_KEY: Required for Gemini AI API calls.
# Obtain a key from Google AI Studio (https://aistudio.google.com/)
# Place your real key in .env.local (do NOT commit real keys to git)
GEMINI_API_KEY="your_gemini_api_key_here"

# GEMINI_MODEL: Model to use for creative brainstorming (e.g., gemini-4-hydrogen)
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# JSON_STORAGE_PATH: Path to JSON storage file
JSON_STORAGE_PATH="./data/telltale.json"

# PORT: Server port
PORT="3000"

# NODE_ENV: Application environment (development | production)
NODE_ENV="development"
